# Copie para .env e ajuste. Para o sistema inteiro, use o fiapx-infra (make up-dev).
PORT=8080
DATABASE_URL=postgresql://fiapx_core:fiapx_core@localhost:5432/fiapx_core
AMQP_URL=amqp://fiapx:fiapx@localhost:5672/
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_VIDEOS=fiapx-videos
S3_BUCKET_ARCHIVES=fiapx-archives
S3_PUBLIC_ENDPOINT=http://localhost:4566
JWT_SECRET=local-dev-secret
