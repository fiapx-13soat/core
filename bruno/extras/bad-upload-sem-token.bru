meta {
  name: Bad path - acesso sem token (401)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/jobs
  auth: none
}

assert {
  res.status: eq 401
}

docs {
  Sem Authorization: Bearer, qualquer rota protegida responde 401 (o JwtAuthGuard barra antes de
  processar). Ex.: listar jobs sem token.
}
