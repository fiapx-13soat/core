meta {
  name: Cancelar job
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/jobs/{{jobId}}/cancel
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Cancela um job não-finalizado (publica ProcessingCancelled). Se o job já está COMPLETED/FAILED,
  responde 409. Faça um upload novo (passo 03) e cancele rápido para ver o 200.
}
